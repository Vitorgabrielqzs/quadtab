<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Quadtab</RootNamespace>
    <AssemblyName>Quadtab</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Quadtab.ico</ApplicationIcon>
    <Product>Quadtab</Product>
    <Version>1.1.0</Version>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <!-- Menos memória: sem instrumentação do JIT e sem a linha extra do coletor de lixo -->
    <TieredPGO>false</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!-- Publicação: um único .exe, já compilado para iniciar rápido (ReadyToRun) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\Quadtab.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Shaders\*.ps" />
    <None Include="Assets\Shaders\*.fx" />
  </ItemGroup>

</Project>
