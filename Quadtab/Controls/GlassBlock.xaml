<UserControl x:Class="Quadtab.Controls.GlassBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Quadtab.Controls"
             xmlns:b="clr-namespace:Quadtab.Behaviors"
             Width="{Binding ItemWidth}" FontFamily="{StaticResource Inter}">
    <Grid>
        <!-- O texto é sempre escuro, nos dois temas -->
        <c:GlassPanel x:Name="Glass" CornerRadius="24" Padding="20,30,20,18" Background="{Binding BlockFill}"
                      ShadowLayers="0 18 30 -12 #80321900, 0 2 6 0 #2E321900"
                      RimColor="#F2FFFFFF" Rim2Color="#80FFFFFF" GlowAlpha="0.4">
            <StackPanel>
                <Grid>
                    <DockPanel Visibility="{Binding IsEditingTitle, Converter={StaticResource Hidden}}">
                        <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="-3,0,6,0" VerticalAlignment="Center">
                            <Ellipse Fill="{StaticResource White50Brush}" />
                            <Ellipse Width="10" Height="10" Fill="{Binding InkBrush}" />
                        </Grid>
                        <c:TrackedText b:UI.Field="title" Text="{Binding Title}" FontSize="16.5" FontWeight="Bold"
                                       Tracking="-0.02" Foreground="{StaticResource BlockInkBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Style="{StaticResource EditBox}" b:EditBox.Mode="line" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource BlockInkBrush}" TextWrapping="NoWrap"
                             Visibility="{Binding IsEditingTitle, Converter={StaticResource Visible}}" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <TextBlock b:UI.Field="text" Text="{Binding Text}" FontSize="14" LineHeight="23.8"
                               LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Foreground="{StaticResource BlockBodyBrush}"
                               Visibility="{Binding IsEditingText, Converter={StaticResource Hidden}}" />
                    <TextBox Style="{StaticResource EditBox}" b:EditBox.Mode="multi" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Foreground="{StaticResource BlockBodyBrush}"
                             Visibility="{Binding IsEditingText, Converter={StaticResource Visible}}" />
                </Grid>
            </StackPanel>
        </c:GlassPanel>

        <c:PinElement Color="{Binding PinColor}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,5,0,0"
                      Visibility="{Binding HasPin, Converter={StaticResource Visible}}" />
        <c:TapeElement Color="{Binding PinColor}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-13,0,0"
                       RenderTransformOrigin="0.5,0.5" Visibility="{Binding HasTape, Converter={StaticResource Visible}}">
            <c:TapeElement.RenderTransform>
                <RotateTransform Angle="-5" />
            </c:TapeElement.RenderTransform>
        </c:TapeElement>
    </Grid>
</UserControl>
