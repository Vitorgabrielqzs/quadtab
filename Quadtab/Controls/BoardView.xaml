<UserControl x:Class="Quadtab.Controls.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Quadtab.Controls"
             xmlns:m="clr-namespace:Quadtab.Models">
    <UserControl.Resources>
        <c:ItemTemplateSelector x:Key="ItemTemplates">
            <c:ItemTemplateSelector.PostIt><DataTemplate><c:PostIt /></DataTemplate></c:ItemTemplateSelector.PostIt>
            <c:ItemTemplateSelector.Page><DataTemplate><c:PageNote /></DataTemplate></c:ItemTemplateSelector.Page>
            <c:ItemTemplateSelector.Block><DataTemplate><c:GlassBlock /></DataTemplate></c:ItemTemplateSelector.Block>
            <c:ItemTemplateSelector.Text><DataTemplate><c:TextLabel /></DataTemplate></c:ItemTemplateSelector.Text>
            <c:ItemTemplateSelector.TextBox><DataTemplate><c:TextBoxView /></DataTemplate></c:ItemTemplateSelector.TextBox>
            <c:ItemTemplateSelector.Shape><DataTemplate><c:ShapeView /></DataTemplate></c:ItemTemplateSelector.Shape>
            <c:ItemTemplateSelector.Line><DataTemplate><c:LineView /></DataTemplate></c:ItemTemplateSelector.Line>
            <c:ItemTemplateSelector.Drawing><DataTemplate><c:DrawingView /></DataTemplate></c:ItemTemplateSelector.Drawing>
            <c:ItemTemplateSelector.Image><DataTemplate><c:ImageView /></DataTemplate></c:ItemTemplateSelector.Image>
            <c:ItemTemplateSelector.Video><DataTemplate><c:VideoView /></DataTemplate></c:ItemTemplateSelector.Video>
            <c:ItemTemplateSelector.File><DataTemplate><c:FileView /></DataTemplate></c:ItemTemplateSelector.File>
            <c:ItemTemplateSelector.Link><DataTemplate><c:LinkView /></DataTemplate></c:ItemTemplateSelector.Link>
            <c:ItemTemplateSelector.Table><DataTemplate><c:TableView /></DataTemplate></c:ItemTemplateSelector.Table>
        </c:ItemTemplateSelector>

        <!-- Cada item: posição no mundo, camada, contorno de seleção e destaque da busca -->
        <Style TargetType="c:BoardItemContainer">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
            <Setter Property="Panel.ZIndex" Value="{Binding Z}" />
            <Setter Property="ContentTemplateSelector" Value="{StaticResource ItemTemplates}" />
            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="c:BoardItemContainer">
                        <Grid>
                            <Border x:Name="Hit" Margin="-10" CornerRadius="10" BorderThickness="3" BorderBrush="#990A84FF"
                                    IsHitTestVisible="False" Visibility="Collapsed" />
                            <ContentPresenter />
                            <Border x:Name="Outline" Margin="-7" CornerRadius="6" BorderThickness="2.5"
                                    BorderBrush="{StaticResource AccentBrush}" IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Outline" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSearchHit}" Value="True">
                                <Setter TargetName="Hit" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:ItemKind.Block}">
                                <Setter TargetName="Outline" Property="CornerRadius" Value="31" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:ItemKind.Line}">
                                <Setter TargetName="Outline" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Moldura: contorna a janela do quadro (a área visível) -->
        <c:FrameBackground x:Name="FrameBg" Model="{Binding Model}">
            <c:FrameBackground.CacheMode>
                <BitmapCache EnableClearType="False" />
            </c:FrameBackground.CacheMode>
        </c:FrameBackground>

        <!-- Superfície infinita + itens. Só a matriz da câmera muda ao mover ou dar zoom. -->
        <Grid x:Name="Surface" Margin="16" Background="Transparent" Focusable="True" FocusVisualStyle="{x:Null}" AllowDrop="True">
            <c:SurfaceBackground x:Name="SurfaceBg" Model="{Binding Model}" ShowGrid="{Binding ShowGrid}" />
            <Canvas x:Name="ItemsLayer">
                <Canvas.RenderTransform>
                    <MatrixTransform x:Name="CameraTransform" />
                </Canvas.RenderTransform>
                <!-- traço sendo desenhado agora (coordenadas do mundo) -->
                <Path x:Name="InkPreview" Panel.ZIndex="2000000000" IsHitTestVisible="False" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
            <!-- Camada de tela: caixa de seleção, guias, alças, pontos de conexão e laço -->
            <Canvas x:Name="Hud">
                <Rectangle x:Name="Marquee" Visibility="Collapsed" Fill="#1F0A84FF" Stroke="#0A84FF" StrokeThickness="1"
                           RadiusX="4" RadiusY="4" IsHitTestVisible="False" />
                <Canvas x:Name="Guides" IsHitTestVisible="False" />
                <Polygon x:Name="Lasso" Visibility="Collapsed" Fill="#140A84FF" Stroke="#0A84FF" StrokeThickness="1.5"
                         StrokeDashArray="4 3" IsHitTestVisible="False" />
                <Line x:Name="ConnectorPreview" Visibility="Collapsed" Stroke="#0A84FF" StrokeThickness="2.5"
                      StrokeDashArray="3 2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" />
                <Canvas x:Name="Adorner" />
                <Canvas x:Name="Ports" />
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
