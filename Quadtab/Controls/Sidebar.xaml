<UserControl x:Class="Quadtab.Controls.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Quadtab.Controls"
             xmlns:b="clr-namespace:Quadtab.Behaviors"
             xmlns:vm="clr-namespace:Quadtab.ViewModels">
    <UserControl.Resources>
        <!-- Linha compacta (ícone de traço + texto), como na lateral do app Claude -->
        <Style x:Key="SideRow" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="b:UI.Radius" Value="10" />
            <Setter Property="b:UI.HoverBackground" Value="{DynamicResource FillBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <!-- Rótulo de seção pequeno e cinza, com setinha (Fixados ▾) -->
        <Style x:Key="SectionHead" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,14,0,2" />
            <Setter Property="b:UI.Radius" Value="8" />
            <Setter Property="b:UI.HoverBackground" Value="Transparent" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style x:Key="TopButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="b:UI.Radius" Value="10" />
            <Setter Property="b:UI.HoverBackground" Value="{DynamicResource FillBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
            <Setter Property="b:Press.IsEnabled" Value="True" />
            <Setter Property="Cursor" Value="Arrow" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="b:UI.Radius" Value="8" />
            <Setter Property="b:UI.HoverBackground" Value="{DynamicResource Fill2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style x:Key="RenameBox" TargetType="TextBox" BasedOn="{StaticResource EditBox}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#1D2130" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Padding" Value="4,1" />
        </Style>

        <!-- Uma linha: quadro, página, item, título, pasta ou arquivo (e os filhos recuados, quando aberta) -->
        <DataTemplate DataType="{x:Type vm:SideNode}">
            <StackPanel>
                <Button x:Name="Row" Tag="{Binding}" ToolTip="{Binding Tip}" AllowDrop="True" Focusable="True" FocusVisualStyle="{x:Null}"
                        Click="OnNodeClick" MouseDoubleClick="OnNodeDoubleClick" PreviewMouseRightButtonUp="OnNodeRightClick"
                        PreviewMouseLeftButtonDown="OnNodeMouseDown" PreviewMouseMove="OnNodeMouseMove" Drop="OnNodeDrop" KeyDown="OnNodeKey">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SideRow}">
                            <Style.Triggers>
                                <!-- quadro aberto: pílula arredondada de destaque -->
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Fill2Brush}" />
                                    <Setter Property="b:UI.HoverBackground" Value="{DynamicResource Fill2Brush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMore}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid Margin="{Binding Indent}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- setinha que abre e fecha os filhos -->
                        <Button Style="{StaticResource RowAction}" Width="20" Height="22" Tag="{Binding}" Click="OnToggleNode"
                                ToolTip="Mostra ou esconde o que tem dentro"
                                Visibility="{Binding CanExpand, Converter={StaticResource Visible}}">
                            <c:Icon Data="{StaticResource IcChevronRight}" Size="13" Foreground="{DynamicResource Ink3Brush}" RenderTransformOrigin="0.5,0.5">
                                <c:Icon.RenderTransform>
                                    <RotateTransform Angle="{Binding ArrowAngle}" />
                                </c:Icon.RenderTransform>
                            </c:Icon>
                        </Button>
                        <Grid Grid.Column="1" Width="18" Margin="0,0,8,0" Visibility="{Binding HasIcon, Converter={StaticResource Visible}}">
                            <c:Icon Data="{Binding Icon, Converter={StaticResource IconOf}}" Size="16" Foreground="{DynamicResource Ink2Brush}" />
                            <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Dot}" BorderBrush="#26000000" BorderThickness="1"
                                    Visibility="{Binding Dot, Converter={StaticResource NullToVisible}, ConverterParameter=inv}" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Visibility="{Binding IsRenaming, Converter={StaticResource Hidden}}" />
                            <TextBox Style="{StaticResource RenameBox}" Text="{Binding Name, Mode=OneWay}" Tag="{Binding}"
                                     Visibility="{Binding IsRenaming, Converter={StaticResource Visible}}"
                                     IsVisibleChanged="OnRenameVisible" KeyDown="OnRenameKey" LostKeyboardFocus="OnRenameLost" />
                        </Grid>
                        <!-- ao passar o mouse: fixar, importante e "…" -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,-4,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                                                <Condition Binding="{Binding HasActions}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Style="{StaticResource RowAction}" Tag="{Binding}" Click="OnPin" ToolTip="{Binding PinTip}">
                                <c:Icon Data="{StaticResource IcPin}" Size="14" />
                            </Button>
                            <Button Style="{StaticResource RowAction}" Tag="{Binding}" Click="OnStar" ToolTip="{Binding StarTip}">
                                <c:Icon Data="{StaticResource IcStar}" Size="14" />
                            </Button>
                            <Button Style="{StaticResource RowAction}" Tag="{Binding}" Click="OnNodeMore" ToolTip="Mais opções: renomear, duplicar, excluir">
                                <c:Icon Data="{StaticResource IcEllipsis}" Size="14" />
                            </Button>
                        </StackPanel>
                        <!-- marcas fixas (sem o mouse em cima) -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,0,0" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <c:Icon Data="{StaticResource IcStar}" Size="13" Foreground="#FF9F0A" Margin="2,0"
                                    Visibility="{Binding IsImportant, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Grid>
                </Button>
                <c:Fold IsOpen="{Binding IsOpen}">
                    <ItemsControl ItemsSource="{Binding Children}" Focusable="False" />
                </c:Fold>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Topo: recolher a lateral, voltar e avançar (também arrasta a janela) -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" Background="Transparent" MouseLeftButtonDown="OnDragArea">
            <Button Style="{StaticResource TopButton}" ToolTip="Esconde a barra lateral" Command="{Binding ToggleSidebarCommand}">
                <c:Icon Data="{StaticResource IcSidebar}" Size="18" />
            </Button>
            <Button Style="{StaticResource TopButton}" Margin="4,0,0,0" ToolTip="Volta para o quadro ou página anterior · Alt+←"
                    Command="{Binding Library.GoBackCommand}" IsEnabled="{Binding Library.CanGoBack}">
                <c:Icon Data="{StaticResource IcChevronLeft}" Size="18" />
            </Button>
            <Button Style="{StaticResource TopButton}" ToolTip="Avança para o próximo quadro ou página · Alt+→"
                    Command="{Binding Library.GoForwardCommand}" IsEnabled="{Binding Library.CanGoForward}">
                <c:Icon Data="{StaticResource IcChevronRight}" Size="18" />
            </Button>
            <Border />
        </DockPanel>

        <!-- Rodapé: tema claro/escuro e Ajustes -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="ThemeButton" Style="{StaticResource TopButton}" Click="OnTheme" ToolTip="Alterna entre o tema claro e o escuro">
                <c:Icon x:Name="ThemeIcon" Data="{StaticResource IcMoon}" Size="18" RenderTransformOrigin="0.5,0.5">
                    <c:Icon.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ThemeScale" />
                            <RotateTransform x:Name="ThemeTurn" />
                        </TransformGroup>
                    </c:Icon.RenderTransform>
                </c:Icon>
            </Button>
            <Button Style="{StaticResource SideRow}" Margin="6,0,0,0" Click="OnSettings" ToolTip="Abre os ajustes do app">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource IcSettings}" Size="17" Foreground="{DynamicResource Ink2Brush}" Margin="0,0,10,0" />
                    <TextBlock Text="Ajustes" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>

        <ScrollViewer Style="{StaticResource OverlayScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <!-- Ações -->
                <Button Style="{StaticResource SideRow}" Click="OnNewBoard" ToolTip="Cria um quadro novo · Ctrl+N">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource IcPlus}" Size="17" Margin="0,0,10,0" />
                        <TextBlock Text="Novo quadro" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SideRow}" Click="OnSearch" ToolTip="Procura em quadros, páginas e textos · Ctrl+K">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource IcSearch}" Size="17" Margin="0,0,10,0" />
                        <TextBlock Text="Procurar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SideRow}" Click="OnTrash" ToolTip="Mostra os quadros apagados nos últimos 30 dias">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Library.TrashCount}" FontSize="12.5" Foreground="{DynamicResource Ink3Brush}"
                                   VerticalAlignment="Center" Visibility="{Binding Library.TrashCount, Converter={StaticResource NonZero}}" />
                        <c:Icon Data="{StaticResource IcTrash}" Size="17" Margin="0,0,10,0" />
                        <TextBlock Text="Apagados recentemente" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>

                <!-- Quadros (pelo último aberto), sem rótulo -->
                <ItemsControl ItemsSource="{Binding Library.Boards}" Focusable="False" Margin="0,14,0,0" AllowDrop="True" Drop="OnRootDrop" />

                <!-- Fixados -->
                <StackPanel Visibility="{Binding Library.HasPinned, Converter={StaticResource Visible}}">
                    <Button Style="{StaticResource SectionHead}" Command="{Binding Library.TogglePinnedSectionCommand}" ToolTip="Mostra ou esconde os fixados">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Fixados" VerticalAlignment="Center" />
                            <c:Icon Data="{StaticResource IcChevronDown}" Size="12" Margin="4,1,0,0" RenderTransformOrigin="0.5,0.5" Foreground="{DynamicResource Ink3Brush}">
                                <c:Icon.RenderTransform><RotateTransform Angle="{Binding Library.PinnedArrow}" /></c:Icon.RenderTransform>
                            </c:Icon>
                        </StackPanel>
                    </Button>
                    <c:Fold IsOpen="{Binding Library.PinnedOpen}">
                        <ItemsControl ItemsSource="{Binding Library.Pinned}" Focusable="False" />
                    </c:Fold>
                </StackPanel>

                <!-- Importantes -->
                <StackPanel Visibility="{Binding Library.HasImportant, Converter={StaticResource Visible}}">
                    <Button Style="{StaticResource SectionHead}" Command="{Binding Library.ToggleImportantSectionCommand}" ToolTip="Mostra ou esconde os importantes">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Importantes" VerticalAlignment="Center" />
                            <c:Icon Data="{StaticResource IcChevronDown}" Size="12" Margin="4,1,0,0" RenderTransformOrigin="0.5,0.5" Foreground="{DynamicResource Ink3Brush}">
                                <c:Icon.RenderTransform><RotateTransform Angle="{Binding Library.ImportantArrow}" /></c:Icon.RenderTransform>
                            </c:Icon>
                        </StackPanel>
                    </Button>
                    <c:Fold IsOpen="{Binding Library.ImportantOpen}">
                        <ItemsControl ItemsSource="{Binding Library.Important}" Focusable="False" />
                    </c:Fold>
                </StackPanel>

                <!-- Cofre: a pasta Documentos\Cofre -->
                <Button Style="{StaticResource SectionHead}" Command="{Binding Library.ToggleVaultSectionCommand}" ToolTip="Mostra ou esconde os arquivos da pasta Cofre">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cofre" VerticalAlignment="Center" />
                        <c:Icon Data="{StaticResource IcChevronDown}" Size="12" Margin="4,1,0,0" RenderTransformOrigin="0.5,0.5" Foreground="{DynamicResource Ink3Brush}">
                            <c:Icon.RenderTransform><RotateTransform Angle="{Binding Library.VaultArrow}" /></c:Icon.RenderTransform>
                        </c:Icon>
                    </StackPanel>
                </Button>
                <c:Fold IsOpen="{Binding Library.VaultOpen}">
                    <ItemsControl ItemsSource="{Binding Library.Vault}" Focusable="False" Margin="0,0,0,8" />
                </c:Fold>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
