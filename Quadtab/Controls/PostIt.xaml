<UserControl x:Class="Quadtab.Controls.PostIt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Quadtab.Controls"
             xmlns:b="clr-namespace:Quadtab.Behaviors"
             Width="{Binding ItemWidth}" FontFamily="{StaticResource Nunito}">
    <Grid x:Name="Root" MinHeight="{Binding ItemMinHeight}">

        <!-- Sombra dupla sob os cantos de baixo (descola com o mouse em cima) -->
        <Grid x:Name="Lift" IsHitTestVisible="False">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="LiftMove" />
            </Grid.RenderTransform>
            <c:Shadow x:Name="ShadowLeft" Layers="0 16 12 0 #6B321900" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                      Margin="9,0,0,12" RenderTransformOrigin="0.5,0.5">
                <c:Shadow.RenderTransform>
                    <TransformGroup>
                        <SkewTransform AngleX="-6" />
                        <RotateTransform Angle="-4" />
                    </TransformGroup>
                </c:Shadow.RenderTransform>
            </c:Shadow>
            <c:Shadow x:Name="ShadowRight" Layers="0 16 12 0 #6B321900" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,9,12" RenderTransformOrigin="0.5,0.5">
                <c:Shadow.RenderTransform>
                    <TransformGroup>
                        <SkewTransform AngleX="6" />
                        <RotateTransform Angle="4" />
                    </TransformGroup>
                </c:Shadow.RenderTransform>
            </c:Shadow>
        </Grid>

        <!-- Sombra de contato + papel -->
        <c:Shadow Layers="0 1 1 0 #1A000000, 0 2 4 0 #1A3C230A" CornerRadius="2.5" />
        <c:PaperElement Paper="{Binding PaperColor}" Ink="{Binding InkColor}">
            <c:PaperElement.Style>
                <Style TargetType="c:PaperElement">
                    <Setter Property="Kind" Value="Note" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Lined}" Value="True">
                            <Setter Property="Kind" Value="Lined" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </c:PaperElement.Style>
        </c:PaperElement>

        <!-- Post-it comum: texto centralizado em maiúsculas -->
        <Grid Margin="16,32,16,26" VerticalAlignment="Center"
              Visibility="{Binding IsPlainNote, Converter={StaticResource Visible}}">
            <c:TrackedText b:UI.Field="text" Text="{Binding Text}" Uppercase="True" FontSize="19" FontWeight="Black"
                           Tracking="0.01" LineHeight="23.94" TextAlignment="Center" Foreground="{StaticResource NoteTextBrush}"
                           Visibility="{Binding IsEditingText, Converter={StaticResource Hidden}}" />
            <TextBox Style="{StaticResource EditBox}" b:EditBox.Mode="note" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="19" FontWeight="Black" TextAlignment="Center" Foreground="{StaticResource NoteTextBrush}"
                     Visibility="{Binding IsEditingText, Converter={StaticResource Visible}}" />
        </Grid>

        <!-- Pautado: título + lista -->
        <StackPanel Margin="16,34,16,28" VerticalAlignment="Top"
                    Visibility="{Binding IsLinedNote, Converter={StaticResource Visible}}">
            <Grid Margin="0,0,0,7">
                <c:TrackedText b:UI.Field="title" Text="{Binding Title}" Uppercase="True" FontSize="13" FontWeight="Black"
                               Tracking="0.06" LineHeight="20" Foreground="{Binding InkBrush}"
                               Visibility="{Binding IsEditingTitle, Converter={StaticResource Hidden}}" />
                <TextBox Style="{StaticResource EditBox}" b:EditBox.Mode="line" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13" FontWeight="Black" Foreground="{Binding InkBrush}" TextWrapping="NoWrap"
                         Visibility="{Binding IsEditingTitle, Converter={StaticResource Visible}}" />
            </Grid>
            <Grid>
                <TextBlock b:UI.Field="text" Text="{Binding Text}" FontSize="15" FontWeight="Bold" LineHeight="27"
                           LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Foreground="{StaticResource LinedTextBrush}"
                           Visibility="{Binding IsEditingText, Converter={StaticResource Hidden}}" />
                <TextBox Style="{StaticResource EditBox}" b:EditBox.Mode="multi" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="15" FontWeight="Bold" Foreground="{StaticResource LinedTextBrush}"
                         Visibility="{Binding IsEditingText, Converter={StaticResource Visible}}" />
            </Grid>
        </StackPanel>

        <!-- Rodapé: data e número -->
        <Grid VerticalAlignment="Bottom" Margin="13,0,13,8" Opacity="0.85" IsHitTestVisible="False">
            <c:TrackedText Text="{Binding DateLabel}" HorizontalAlignment="Left" FontSize="10" FontWeight="ExtraBold"
                           Tracking="0.12" Wrap="False" Foreground="{Binding InkBrush}" />
            <c:TrackedText Text="{Binding Number}" HorizontalAlignment="Right" FontSize="10" FontWeight="ExtraBold"
                           Tracking="0.12" Wrap="False" Foreground="{Binding InkBrush}" />
        </Grid>

        <!-- Fixação -->
        <c:PinElement Color="{Binding PinColor}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,5,0,0"
                      Visibility="{Binding HasPin, Converter={StaticResource Visible}}" />
        <c:TapeElement Color="{Binding PinColor}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-13,0,0"
                       RenderTransformOrigin="0.5,0.5" Visibility="{Binding HasTape, Converter={StaticResource Visible}}">
            <c:TapeElement.RenderTransform>
                <RotateTransform Angle="-5" />
            </c:TapeElement.RenderTransform>
        </c:TapeElement>
    </Grid>
</UserControl>
