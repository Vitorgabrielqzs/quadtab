<UserControl x:Class="Quadtab.Controls.Tray"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Quadtab.Controls">
    <UserControl.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
            <Setter Property="Margin" Value="2,14,2,10" />
        </Style>
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Center">
        <!-- Painel da bandeja (abre acima do dock) -->
        <c:GlassPanel x:Name="Sheet" Width="620" CornerRadius="34" Padding="20,10,20,20" Margin="0,0,0,12"
                      Background="{DynamicResource Glass2Brush}"
                      RenderTransformOrigin="0.5,1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
            <c:GlassPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SheetScale" ScaleX="0.95" ScaleY="0.95" />
                    <TranslateTransform x:Name="SheetMove" Y="18" />
                </TransformGroup>
            </c:GlassPanel.RenderTransform>

            <StackPanel>
                <Border Width="40" Height="5" CornerRadius="2.5" Background="{DynamicResource Fill2Brush}" Margin="0,0,0,12" />
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallCircleButton}" VerticalAlignment="Top"
                            ToolTip="Fecha a bandeja" Command="{Binding ToggleTrayCommand}">
                        <c:Icon Data="{StaticResource IcClose}" Size="15" />
                    </Button>
                    <StackPanel>
                        <c:TrackedText Text="Bandeja" FontSize="20" FontWeight="Bold" Tracking="-0.025" Wrap="False" />
                        <TextBlock Text="Arraste um elemento para o quadro ou clique para adicionar no centro" FontSize="13.5"
                                   Foreground="{DynamicResource Ink2Brush}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="Elementos" Style="{StaticResource SectionLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <Button x:Name="CardPage" Grid.Column="0" Grid.Row="0" Style="{StaticResource TrayCard}" ToolTip="Cola uma folha de caderno (clique ou arraste para o quadro)">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource IcPage}" Size="22" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                            <TextBlock Text="Página" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CardBlock" Grid.Column="2" Grid.Row="0" Style="{StaticResource TrayCard}" ToolTip="Cola um bloco com título livre e texto">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource IcBlock}" Size="22" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                            <TextBlock Text="Bloco" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CardText" Grid.Column="4" Grid.Row="0" Style="{StaticResource TrayCard}" ToolTip="Cola um texto grande e solto">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource IcText}" Size="22" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                            <TextBlock Text="Texto" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CardBox" Grid.Column="0" Grid.Row="1" Style="{StaticResource TrayCard}" ToolTip="Cola uma caixa só com texto" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource IcTextBox}" Size="22" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                            <TextBlock Text="Caixa de texto" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CardShape" Grid.Column="2" Grid.Row="1" Style="{StaticResource TrayCard}" ToolTip="Cola uma forma (troque pelo botão direito)" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource IcShapes}" Size="22" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                            <TextBlock Text="Forma" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CardTable" Grid.Column="4" Grid.Row="1" Style="{StaticResource TrayCard}" ToolTip="Cola uma tabela" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource IcTable}" Size="22" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                            <TextBlock Text="Tabela" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </c:GlassPanel>

        <!-- Dock (sempre visível) -->
        <c:GlassPanel x:Name="Dock" CornerRadius="28" Height="56" Padding="6" HorizontalAlignment="Center"
                     >
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource DockButton}" Margin="0,0,1,0" ToolTip="Abre a bandeja de elementos"
                        Command="{Binding ToggleTrayCommand}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource IcTray}" />
                        <TextBlock Text="Bandeja" Margin="7,0" VerticalAlignment="Center" />
                        <c:Icon x:Name="Chevron" Data="{StaticResource IcChevronUp}" RenderTransformOrigin="0.5,0.5">
                            <c:Icon.RenderTransform>
                                <RotateTransform x:Name="ChevronTurn" />
                            </c:Icon.RenderTransform>
                        </c:Icon>
                    </StackPanel>
                </Button>
                <Border Width="1" Height="24" Background="{DynamicResource SepBrush}" Margin="4,0" />
                <Button x:Name="QuickPage" Style="{StaticResource DockButton}" Margin="1,0" ToolTip="Cola uma página no centro do quadro">
                    <c:Icon Data="{StaticResource IcPage}" />
                </Button>
                <Button x:Name="QuickText" Style="{StaticResource DockButton}" Margin="1,0" ToolTip="Cola um texto no centro do quadro">
                    <c:Icon Data="{StaticResource IcText}" />
                </Button>
                <Button x:Name="QuickBlock" Style="{StaticResource DockButton}" Margin="1,0" ToolTip="Cola um bloco no centro do quadro">
                    <c:Icon Data="{StaticResource IcBlock}" />
                </Button>
                <Button x:Name="QuickShape" Style="{StaticResource DockButton}" Margin="1,0,0,0" ToolTip="Cola uma forma no centro do quadro">
                    <c:Icon Data="{StaticResource IcShapes}" />
                </Button>
            </StackPanel>
        </c:GlassPanel>
    </StackPanel>
</UserControl>
