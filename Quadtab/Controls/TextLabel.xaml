<UserControl x:Class="Quadtab.Controls.TextLabel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Quadtab.Controls"
             xmlns:b="clr-namespace:Quadtab.Behaviors"
             FontFamily="{StaticResource Inter}">
    <Grid Margin="10,2">
        <c:TrackedText x:Name="Label" b:UI.Field="text" Text="{Binding Text, Converter={StaticResource NoteText}}" Rich="True" FontSize="{Binding FontSizeValue}" FontFamily="{Binding TitleFont}" FontWeight="{Binding TitleWeight}"
                       Tracking="-0.02" Wrap="False"
                       Visibility="{Binding IsEditingText, Converter={StaticResource Hidden}}" />
        <c:RichEditBox x:Name="Editor" b:EditBox.Mode="line" Wrap="False" Markdown="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                 MinWidth="420" FontSize="{Binding FontSizeValue}" FontFamily="{Binding TitleFont}" FontWeight="{Binding TitleWeight}" Background="Transparent"
                 Visibility="{Binding IsEditingText, Converter={StaticResource Visible}}" />
    </Grid>
</UserControl>
