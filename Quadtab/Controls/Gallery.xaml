<UserControl x:Class="Quadtab.Controls.Gallery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Quadtab.Controls"
             xmlns:b="clr-namespace:Quadtab.Behaviors"
             xmlns:vm="clr-namespace:Quadtab.ViewModels">
    <!-- Galeria: grade de cartões de vidro com miniatura, nome e data -->
    <c:GlassPanel CornerRadius="32" Padding="28,22,20,20" Background="{DynamicResource Glass2Brush}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,8,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallCircleButton}" ToolTip="Fecha a galeria e volta ao quadro · Esc" Command="{Binding Library.CloseGalleryCommand}" VerticalAlignment="Center">
                    <c:Icon Data="{StaticResource IcClose}" Size="15" />
                </Button>
                <!-- ordenar por data ou nome -->
                <Border DockPanel.Dock="Right" Height="34" Width="170" CornerRadius="11" Background="{DynamicResource FillBrush}" Margin="0,0,12,0" Padding="2">
                    <UniformGrid Columns="2">
                        <RadioButton Style="{StaticResource SegmentItem}" Content="Data" GroupName="GSort" ToolTip="Ordena pelos editados por último"
                                     IsChecked="{Binding Library.GallerySort, Converter={StaticResource Is}, ConverterParameter=data}" />
                        <RadioButton Style="{StaticResource SegmentItem}" Content="Nome" GroupName="GSort" ToolTip="Ordena em ordem alfabética"
                                     IsChecked="{Binding Library.GallerySort, Converter={StaticResource Is}, ConverterParameter=nome}" />
                    </UniformGrid>
                </Border>
                <Button DockPanel.Dock="Right" Style="{StaticResource CapButton}" Margin="0,0,12,0" Click="OnNewBoard" ToolTip="Cria um quadro novo · Ctrl+N">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource IcPlus}" />
                        <TextBlock Text="Novo quadro" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <c:TrackedText Text="{Binding Library.GalleryTitle}" FontSize="28" FontWeight="ExtraBold" Tracking="-0.03" Wrap="False" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer Style="{StaticResource OverlayScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Library.Gallery}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GalleryCard}">
                            <Button Style="{StaticResource SoftButton}" Width="236" Height="214" Margin="0,0,16,16" b:UI.Radius="22"
                                    b:Press.IsEnabled="True" Tag="{Binding}" Click="OnCardClick" PreviewMouseRightButtonUp="OnCardRightClick" ToolTip="Abre este quadro (botão direito: mais opções)"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <c:GlassPanel CornerRadius="22" Padding="10">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Bottom" Margin="4,10,4,0">
                                            <c:Icon DockPanel.Dock="Right" Data="{StaticResource IcStar}" Size="16" Foreground="{DynamicResource AccentBrush}"
                                                    Visibility="{Binding IsFavorite, Converter={StaticResource Visible}}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DateLabel}" FontSize="12" Foreground="{DynamicResource Ink3Brush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Grid>
                                            <Border CornerRadius="14" ClipToBounds="True">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#EAD1A6" Offset="0" />
                                                        <GradientStop Color="#C0965C" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border CornerRadius="14">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Thumb, Converter={StaticResource ImagePath}, ConverterParameter=440}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                            <c:BoardIcon Model="{Binding Model}" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Visibility="{Binding Thumb, Converter={StaticResource NullToVisible}}" />
                                            <!-- lixeira: restaurar / apagar de vez -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                                        Visibility="{Binding IsTrash, Converter={StaticResource Visible}}">
                                                <Button Style="{StaticResource PillButton}" Content="Restaurar" Tag="{Binding}" Click="OnRestore" ToolTip="Devolve o quadro para a lista" Background="{StaticResource AccentBrush}" Foreground="White" />
                                                <Button Style="{StaticResource PillButton}" Content="Apagar" Tag="{Binding}" Click="OnDeleteForever" ToolTip="Apaga o quadro para sempre" />
                                            </StackPanel>
                                        </Grid>
                                    </DockPanel>
                                </c:GlassPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </c:GlassPanel>
</UserControl>
