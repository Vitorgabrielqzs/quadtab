<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Tema claro (tokens da seção 3.1). Cores com alfa no formato #AARRGGBB. -->
    <sys:Boolean x:Key="IsDark">False</sys:Boolean>

    <Color x:Key="BgColor">#EEF0F4</Color>
    <Color x:Key="Blob1Color">#FFDDE8</Color>
    <Color x:Key="Blob2Color">#D4E4FF</Color>
    <Color x:Key="Blob3Color">#D7F4E7</Color>
    <Color x:Key="RimColor">#F2FFFFFF</Color>
    <Color x:Key="Rim2Color">#80FFFFFF</Color>

    <SolidColorBrush x:Key="BgBrush" Color="#EEF0F4" />
    <SolidColorBrush x:Key="InkBrush" Color="#0F1115" />
    <SolidColorBrush x:Key="Ink2Brush" Color="#4F5563" />
    <SolidColorBrush x:Key="Ink3Brush" Color="#646A79" />
    <!-- Vidro com um leve tom azulado: separa a lateral, a bandeja e os painéis do quadro branco -->
    <SolidColorBrush x:Key="GlassBrush" Color="#C7E4ECFA" />
    <SolidColorBrush x:Key="Glass2Brush" Color="#E8E9EFFB" />
    <!-- Menus e bandejas que abrem por cima do quadro: quase opacos, para nada aparecer atrás -->
    <SolidColorBrush x:Key="MenuGlassBrush" Color="#F7EEF3FC" />
    <SolidColorBrush x:Key="FillBrush" Color="#1F767C91" />
    <SolidColorBrush x:Key="Fill2Brush" Color="#33767C91" />
    <SolidColorBrush x:Key="SepBrush" Color="#173C425A" />
    <SolidColorBrush x:Key="SegIndicatorBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E5312B" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FE5312B" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#38000000" />

    <!-- Quadro no estilo do Canvas do Obsidian: fundo liso com pontinhos e cartões retos -->
    <Color x:Key="CanvasColor">#FFFFFF</Color>
    <Color x:Key="CanvasDotColor">#D4D6DC</Color>
    <SolidColorBrush x:Key="CanvasBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CanvasEdgeBrush" Color="#1F3C425A" />
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#D9DCE3" />
    <SolidColorBrush x:Key="CardTextBrush" Color="#1F2229" />

    <sys:Double x:Key="GlowAlpha">0.34</sys:Double>
    <sys:String x:Key="GlassShadow">0 14 36 0 #1A1E243C, 0 1 3 0 #0F1E243C</sys:String>
</ResourceDictionary>
