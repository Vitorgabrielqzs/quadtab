<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="clr-namespace:Quadtab.Behaviors"
                    xmlns:c="clr-namespace:Quadtab.Controls">

    <!-- Vidro padrão: cores do tema atual -->
    <Style TargetType="c:GlassPanel">
        <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
        <Setter Property="ShadowLayers" Value="{DynamicResource GlassShadow}" />
        <Setter Property="RimColor" Value="{DynamicResource RimColor}" />
        <Setter Property="Rim2Color" Value="{DynamicResource Rim2Color}" />
        <Setter Property="GlowAlpha" Value="{DynamicResource GlowAlpha}" />
    </Style>

    <!-- Contorno de foco do teclado -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource AccentBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Base de todos os botões: sem a aparência padrão do Windows -->
    <Style x:Key="SoftButton" TargetType="ButtonBase">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="b:UI.HoverBackground" Value="{DynamicResource FillBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding b:UI.Radius}" />
                        <Border x:Name="Hover" Background="{TemplateBinding b:UI.HoverBackground}" CornerRadius="{TemplateBinding b:UI.Radius}"
                                Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover: troca o fundo pela cor de hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0" />
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botões dentro das cápsulas de vidro -->
    <Style x:Key="CapButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="b:UI.Radius" Value="20" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="b:Press.IsEnabled" Value="True" />
    </Style>

    <Style x:Key="DockButton" TargetType="Button" BasedOn="{StaticResource CapButton}">
        <Setter Property="Height" Value="44" />
        <Setter Property="b:UI.Radius" Value="22" />
    </Style>

    <!-- Botão redondo de 38 (recolher lateral) -->
    <Style x:Key="RoundButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="b:UI.Radius" Value="19" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="b:Press.IsEnabled" Value="True" />
    </Style>

    <!-- Botão ✕ de 32 da bandeja -->
    <Style x:Key="SmallCircleButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="b:UI.Radius" Value="16" />
        <Setter Property="Background" Value="{DynamicResource FillBrush}" />
        <Setter Property="b:UI.HoverBackground" Value="{DynamicResource Fill2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="b:Press.IsEnabled" Value="True" />
    </Style>

    <!-- Linhas da seção "Quadros" -->
    <Style x:Key="SidebarRow" TargetType="Button" BasedOn="{StaticResource SoftButton}">
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="b:UI.Radius" Value="13" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Linhas da lista "No quadro" -->
    <Style x:Key="OutlineRow" TargetType="Button" BasedOn="{StaticResource SoftButton}">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="b:UI.Radius" Value="12" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter Property="b:UI.HoverBackground" Value="{StaticResource AccentSoftBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Opções do controle segmentado -->
    <Style x:Key="SegmentItem" TargetType="RadioButton" BasedOn="{StaticResource SoftButton}">
        <Setter Property="b:UI.Radius" Value="10" />
        <Setter Property="b:UI.HoverBackground" Value="Transparent" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Linhas do menu do botão direito -->
    <Style x:Key="MenuRow" TargetType="Button" BasedOn="{StaticResource SoftButton}">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="b:UI.Radius" Value="14" />
        <Setter Property="b:UI.HoverBackground" Value="{DynamicResource Fill2Brush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="MenuRowDanger" TargetType="Button" BasedOn="{StaticResource MenuRow}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="b:UI.HoverBackground" Value="{DynamicResource DangerSoftBrush}" />
    </Style>

    <!-- Chips (estilo do post-it) -->
    <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource SoftButton}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="b:UI.Radius" Value="15" />
        <Setter Property="Background" Value="{DynamicResource FillBrush}" />
        <Setter Property="b:UI.HoverBackground" Value="{DynamicResource Fill2Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="b:Press.IsEnabled" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="b:UI.HoverBackground" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botão em pílula (30 de altura) -->
    <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="b:UI.Radius" Value="15" />
        <Setter Property="Background" Value="{DynamicResource Glass2Brush}" />
        <Setter Property="b:UI.HoverBackground" Value="{DynamicResource Fill2Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="b:Press.IsEnabled" Value="True" />
    </Style>

    <!-- Cartões da bandeja -->
    <Style x:Key="TrayCard" TargetType="Button" BasedOn="{StaticResource SoftButton}">
        <Setter Property="Height" Value="62" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="b:UI.Radius" Value="18" />
        <Setter Property="Background" Value="{DynamicResource FillBrush}" />
        <Setter Property="b:UI.HoverBackground" Value="{StaticResource Accent14Brush}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="b:Press.IsEnabled" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Miniaturas de modelo no menu -->
    <Style x:Key="ModelThumb" TargetType="RadioButton" BasedOn="{StaticResource SoftButton}">
        <Setter Property="Padding" Value="2,6" />
        <Setter Property="b:UI.Radius" Value="12" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Arrow" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter Property="b:UI.HoverBackground" Value="{StaticResource AccentSoftBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bolinhas de cor (24 px) -->
    <Style x:Key="ColorDot" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Ring" Margin="-4" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Visibility="Collapsed" />
                        <c:Shadow Layers="0 2 4 0 #1F000000" CornerRadius="12" />
                        <Ellipse Fill="{TemplateBinding Background}" Stroke="#1F000000" StrokeThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo de busca -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo de edição dos itens: fundo branco 60%, raio 6, anel de 2 px na cor de destaque -->
    <Style x:Key="EditBox" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{StaticResource EditBackBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionOpacity" Value="0.3" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border Margin="-2" CornerRadius="8" BorderThickness="2" BorderBrush="{StaticResource AccentBrush}" />
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barras de rolagem finas e arredondadas -->
    <Style x:Key="ThinThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Margin="3" CornerRadius="3" Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=ScrollBar}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Tag" Value="{DynamicResource ScrollThumbBrush}" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource PageButton}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource PageButton}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ThinThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource PageButton}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource PageButton}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Rolagem com barras por cima do conteúdo (não roubam espaço) -->
    <Style x:Key="OverlayScroll" TargetType="ScrollViewer">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Orientation="Horizontal" VerticalAlignment="Bottom"
                                   Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
